// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===============================================
// MODEL UNTUK USER DAN OTENTIKASI
// ===============================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(TECHNICIAN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // soft delete

  servicesAssigned      Service[]
  transactionsRecorded  Transaction[]
  itemAdjustmentsMade   ItemAdjustment[] @relation("RecordedByUser")
}

enum Role {
  OWNER
  ACCOUNTANT
  TECHNICIAN
}

// ===============================================
// MODEL UNTUK CUSTOMER DAN SERVICE
// ===============================================

model Customer {
  id      String   @id @default(cuid())
  name    String
  phone   String   @unique
  address String?
  notes   String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services     Service[]
  transactions Transaction[]
}


model Service {
  id        Int       @id @default(autoincrement()) // Ini nomor tiket utama
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relasi ke Customer
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String

  // Relasi ke Teknisi yang ditugaskan (bisa di-assign ke tiketnya)
  technician   User?     @relation(fields: [technicianId], references: [id])
  technicianId String?

  // SATU Tiket Servis bisa punya BANYAK Device
  devices   Device[]

  // Transaksi pembayaran untuk seluruh tiket ini
  paymentTransaction Transaction?
}


enum ServiceStatus {
  CONFIRMATION
  PENDING
  IN_PROGRESS
  COMPLETED
  RETURNED_TO_CUSTOMER
  CANCELLED
}

model Device {
  id                   Int           @id @default(autoincrement())
  deviceType           String        // Contoh: "Laptop", "HP"
  problemDescription   String        // Keluhan
  accessoriesLeft      String?       // "Yang ditinggalkan", contoh: "Charger ori, Tas"
  status               ServiceStatus @default(PENDING) // Status per-device
  completedAt          DateTime?

  // Relasi kembali ke Tiket Servis utama
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId Int
}

// ===============================================
// MODEL UNTUK MANAJEMEN STOK & ASET
// ===============================================

model Item {
  id            String    @id @default(cuid())
  name          String   
    description   String?
  quantity      Int       @default(0)
  purchasePrice Decimal
  sellingPrice  Decimal?
  type          ItemType
  // 'deletedAt' digunakan HANYA jika Anda ingin menonaktifkan seluruh kategori item ini.
  deletedAt     DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // REVISI: Nama relasi diubah agar lebih umum
  adjustments ItemAdjustment[]
  // Satu Item bisa terlibat dalam banyak Transaksi.
  transactions  Transaction[] @relation("ItemTransactions")
}

enum ItemType {
  STOCK
  ASSET
}

// REVISI: Nama model diubah dari StockAdjustment menjadi ItemAdjustment
// karena sekarang menangani ASET dan STOK.
model ItemAdjustment {
  id             String   @id @default(cuid())
  quantityChange Int      // Contoh: -1 (untuk pengurangan), +2 (untuk penambahan)
  reason         String   // Contoh: "Rusak total", "Hilang", "Koreksi hasil stock opname"
  adjustedAt     DateTime @default(now())

  // Relasi ke item yang disesuaikan
  item    Item   @relation(fields: [itemId], references: [id])
  itemId  String
  
  // Relasi ke user yang melakukan penyesuaian
  recordedBy   User   @relation("RecordedByUser", fields: [recordedById], references: [id])
  recordedById String
}

// ... model Transaction tetap sama ...
model Transaction {
  id              String          @id @default(cuid())
  description     String
  type            TransactionType
  amount          Decimal
  transactionDate DateTime        @default(now())
  category        String?         // Tambahkan field category

  // --- Relasi yang sudah ada ---
  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?

  service   Service? @relation(fields: [serviceId], references: [id])
  serviceId Int?     @unique

  recordedBy   User     @relation(fields: [recordedById], references: [id])
  recordedById String
  
  createdAt DateTime @default(now())

  // --- PENAMBAHAN KUNCI UNTUK INTEGRASI ERP ---
  // Jika transaksi ini terkait dengan pembelian atau penjualan item,
  // kita catat item apa dan berapa jumlahnya.
  
  // Relasi ke Item (opsional)
  // Satu Transaksi hanya terkait dengan satu jenis Item.
  item         Item?     @relation("ItemTransactions", fields: [itemId], references: [id])
  itemId       String?

  // Kuantitas item yang terlibat dalam transaksi ini
  itemQuantity Int?
}

enum TransactionType {
  INCOME  // Pemasukan
  EXPENSE // Pengeluaran
}
